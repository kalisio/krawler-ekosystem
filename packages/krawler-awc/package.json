{
  "name": "@kalisio/krawler-awc",
  "description": "Job scraping METAR and TAF data from the Aviation Weather Center.",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "keywords": [
    "krawler",
    "kargo",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/krawler-ekosystem.git",
    "directory": "packages/krawler-awc"
  },
  "bugs": {
    "url": "https://github.com/kalisio/krawler-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/krawler-ekosystem/tree/master/packages/krawler-awc",
  "scripts": {
    "build": "pnpm --filter \"@kalisio/krawler-awc\" -r \"/^build:.*/\"",
    "build:metars": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-awc:metars-${IMAGE_TAG:-dev} -f dockerfile.metars ../..",
    "build:stations": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-awc:stations-${IMAGE_TAG:-dev} -f dockerfile.stations ../..",
    "build:tafs": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-awc:tafs-${IMAGE_TAG:-dev} -f dockerfile.tafs ../..",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/krawler-awc@0.0.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/krawler-awc@0.0.0",
    "lint": "standard --fix"
  },
  "krawler": {
    "version": "2.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lodash": "catalog:",
    "winston": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/krawler": "workspace:*"
  }
}
