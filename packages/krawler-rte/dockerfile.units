ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-rte/package.json ./packages/krawler-rte/
COPY packages/krawler-rte/jobfile-units.js \
     packages/krawler-rte/plants.csv \
     packages/krawler-rte/reactors.csv \
     ./packages/krawler-rte/

RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-rte --prod


FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 0 0 * * *"

COPY --from=builder --chown=node:node /app /app/

RUN rm -rf /app/packages/krawler-rte/node_modules/@kalisio/krawler \
 && ln -s /krawler/packages/krawler /app/packages/krawler-rte/node_modules/@kalisio/krawler

WORKDIR /app/packages/krawler-rte

CMD ["sh", "-c", "krawler --cron \"$CRON\" --run jobfile-units.js"]
