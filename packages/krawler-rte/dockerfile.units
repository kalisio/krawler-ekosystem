ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-rte/package.json ./packages/krawler-rte/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-rte --prod

COPY packages/krawler-rte/jobfile-units.js \
     packages/krawler-rte/plants.csv \
     packages/krawler-rte/reactors.csv \
     ./packages/krawler-rte/

FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 0 0 * * *"

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-rte /app/packages/krawler-rte

USER root
RUN rm -rf /app/packages/krawler-rte/node_modules/@kalisio/krawler \
 && ln -s /opt/krawler /app/packages/krawler-rte/node_modules/@kalisio/krawler
USER node

WORKDIR /app/packages/krawler-rte

CMD krawler --cron "$CRON" --run jobfile-units.js
