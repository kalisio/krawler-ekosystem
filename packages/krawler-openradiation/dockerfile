ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

#
# Builder stage: install the job's prod deps using pnpm.
# @kalisio/krawler is declared as a peer dep so it won't be installed here —
# the runtime image already provides it.
#
FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-openradiation/package.json ./packages/krawler-openradiation/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-openradiation --prod

COPY packages/krawler-openradiation/jobfile.js ./packages/krawler-openradiation/

#
# Runtime stage: published krawler image matching KRAWLER_TAG.
#
FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 * * * * *"

# Preserve the workspace layout so the symlinks under
# packages/<job>/node_modules/* (pointing to ../../../node_modules/.pnpm/...) resolve.
COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-openradiation /app/packages/krawler-openradiation

# Replace the workspace-resolved @kalisio/krawler with the framework provided
# by the krawler base image, so the KRAWLER_TAG actually drives the runtime.
USER root
RUN rm -rf /app/packages/krawler-openradiation/node_modules/@kalisio/krawler \
 && ln -s /opt/krawler /app/packages/krawler-openradiation/node_modules/@kalisio/krawler
USER node

WORKDIR /app/packages/krawler-openradiation

CMD krawler --cron "$CRON" --run jobfile.js
