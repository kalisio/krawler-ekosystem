{
  "name": "@kalisio/krawler-centipede",
  "description": "A Krawler based service to get the antennas status of the RTK Centipede Network",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "keywords": [
    "krawler",
    "kargo",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/krawler-ekosystem.git",
    "directory": "packages/krawler-centipede"
  },
  "bugs": {
    "url": "https://github.com/kalisio/krawler-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/krawler-ekosystem/tree/master/packages/krawler-centipede",
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-centipede:${IMAGE_TAG:-dev} -f dockerfile ../..",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/krawler-centipede@0.0.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/krawler-centipede@0.0.0",
    "lint": "standard --fix"
  },
  "krawler": {
    "version": "2.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lodash": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/krawler": "workspace:*"
  }
}
