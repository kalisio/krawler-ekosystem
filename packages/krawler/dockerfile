ARG DEBIAN_VERSION=bookworm
ARG NODE_VERSION=20

#
# Builder stage: install workspace deps and build @kalisio/krawler
#
FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler/package.json ./packages/krawler/
COPY packages/krawler/src ./packages/krawler/src/
COPY packages/krawler/healthcheck.js ./packages/krawler/

# corepack will install pnpm version that's specified in package.json packageManager
# use --ignore-scripts otherwise 'prepare' script will run after install, trying to setup husky
RUN corepack enable && pnpm install --prod --ignore-scripts --frozen-lockfile --filter @kalisio/krawler


#
# Runtime stage: slim image with prod deps, built artifacts and the krawler bin
#
FROM node:${NODE_VERSION}-${DEBIAN_VERSION}-slim
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

WORKDIR /krawler

COPY --from=builder --chown=node:node /app ./

# Expose the `krawler` bin globally.
RUN corepack enable && cd packages/krawler && PNPM_HOME=/usr/local/bin pnpm link --global

USER node

WORKDIR /krawler/packages/krawler

HEALTHCHECK --interval=30s --timeout=30s --start-period=30s CMD node ./healthcheck.js

ENV NODE_ENV=production

CMD ["sh", "-c", "krawler $ARGS"]
