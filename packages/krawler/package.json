{
  "name": "@kalisio/krawler",
  "description": "A minimalist geospatial ETL",
  "version": "2.8.2",
  "type": "module",
  "bin": "./src/bin.js",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "healthcheck.js"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "bash -c 'source ../../../development/workspaces/jobs/jobs.sh krawler && vitest run --coverage'"
  },
  "keywords": [
    "feathers",
    "feathers-plugin",
    "etl",
    "gis",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/krawler-ekosystem.git",
    "directory": "packages/krawler"
  },
  "bugs": {
    "url": "https://github.com/kalisio/krawler-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/krawler-ekosystem/tree/main/packages/krawler",
  "engines": {
    "node": ">= 20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
