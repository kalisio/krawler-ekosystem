ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM kalisio/kazarr-conversion-tool:latest AS conversion-tool

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-meteofrance/package.json ./packages/krawler-meteofrance/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-meteofrance --prod

COPY packages/krawler-meteofrance/jobfile.grib2-to-zarr.js packages/krawler-meteofrance/templates.json ./packages/krawler-meteofrance/

FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 21 * * *"

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-meteofrance /app/packages/krawler-meteofrance
COPY --from=conversion-tool /app/dist/conversion_tool /app/packages/krawler-meteofrance/conversion_tool

RUN rm -rf /app/packages/krawler-meteofrance/node_modules/@kalisio/krawler \
 && ln -s /app/packages/krawler /app/packages/krawler-meteofrance/node_modules/@kalisio/krawler \
 && chown node:node /app/packages/krawler-meteofrance/conversion_tool

WORKDIR /app/packages/krawler-meteofrance

CMD krawler --cron "$CRON" --run jobfile.grib2-to-zarr.js
