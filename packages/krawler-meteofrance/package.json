{
  "name": "@kalisio/krawler-meteofrance",
  "description": "A Krawler job designed to scrape data from the Météo-France public API",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "keywords": [
    "krawler",
    "kargo",
    "feathers",
    "meteofrance",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/krawler-ekosystem.git",
    "directory": "packages/krawler-meteofrance"
  },
  "bugs": {
    "url": "https://github.com/kalisio/krawler-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/krawler-ekosystem/tree/main/packages/krawler-meteofrance",
  "scripts": {
    "build:arome-france": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:arome-france-${TAG:-latest} -f dockerfile.arome-france ../..",
    "build:arome-france-high": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:arome-france-high-${TAG:-latest} -f dockerfile.arome-france-high ../..",
    "build:arpege-europe": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:arpege-europe-${TAG:-latest} -f dockerfile.arpege-europe ../..",
    "build:arpege-world": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:arpege-world-${TAG:-latest} -f dockerfile.arpege-world ../..",
    "build:grib2-to-zarr": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:grib2-to-zarr-${TAG:-latest} -f dockerfile.grib2-to-zarr ../..",
    "build:paquetobs-observations": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:paquetobs-observations-${TAG:-latest} -f dockerfile.paquetobs-observations ../..",
    "build:paquetobs-stations": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=$(node -p \"require('./package.json').krawler.version\") -t krawler-meteofrance:paquetobs-stations-${TAG:-latest} -f dockerfile.paquetobs-stations ../.."
  },
  "krawler": {
    "version": "2.8.2"
  },
  "dependencies": {
    "lodash": "catalog:",
    "moment": "catalog:",
    "winston": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/krawler": "workspace:*"
  }
}
