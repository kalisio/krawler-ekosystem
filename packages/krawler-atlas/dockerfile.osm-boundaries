ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

#
# Builder stage: install the job's prod deps using pnpm.
# @kalisio/krawler is a peer dep so it won't be installed here —
# the runtime image already provides it.
#
FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-atlas/package.json ./packages/krawler-atlas/
COPY packages/krawler-atlas/jobfile-osm-boundaries.js \
     packages/krawler-atlas/jobfile-osm-planet-boundaries.js \
     ./packages/krawler-atlas/

RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-atlas --prod


#
# Runtime stage: published krawler image matching KRAWLER_TAG.
#
FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 0 4 1 * *"

USER root

# Install osmium-tool build dependencies
RUN apt-get update && apt-get -y install \
    libprotozero-dev rapidjson-dev libboost-program-options-dev \
    libbz2-dev zlib1g-dev liblz4-dev libexpat1-dev \
    cmake build-essential pandoc git nlohmann-json3-dev \
    libsqlite3-dev

# Build libosmium
WORKDIR /opt
RUN git clone https://github.com/osmcode/libosmium
WORKDIR /opt/libosmium/build
RUN cmake .. && make && make install

# Build osmium-tool
WORKDIR /opt
RUN git clone https://github.com/osmcode/osmium-tool.git
WORKDIR /opt/osmium-tool/build
RUN cmake .. && make && make install

# Install mapshaper
RUN npm install -g mapshaper

# Build tippecanoe
WORKDIR /opt
RUN git clone https://github.com/felt/tippecanoe.git
WORKDIR /opt/tippecanoe
RUN make -j && make install

COPY --from=builder --chown=node:node /app /app/

RUN rm -rf /app/packages/krawler-atlas/node_modules/@kalisio/krawler \
 && ln -s /app/packages/krawler /app/packages/krawler-atlas/node_modules/@kalisio/krawler

USER node

WORKDIR /app/packages/krawler-atlas

CMD krawler --cron "$CRON" --run jobfile-osm-boundaries.js
