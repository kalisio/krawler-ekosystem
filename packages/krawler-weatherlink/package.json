{
  "name": "@kalisio/krawler-weatherlink",
  "description": "A Krawler based job to download data from the WeatherLink weather station network.",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "keywords": [
    "krawler",
    "kargo",
    "feathers",
    "weatherlink",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/krawler-ekosystem.git",
    "directory": "packages/krawler-weatherlink"
  },
  "bugs": {
    "url": "https://github.com/kalisio/krawler-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/krawler-ekosystem/tree/main/packages/krawler-weatherlink",
  "scripts": {
    "build:stations": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-weatherlink:stations-${IMAGE_TAG:-dev} -f dockerfile.stations ../..",
    "build:observations": "DOCKER_BUILDKIT=1 docker build --build-arg KRAWLER_TAG=${KRAWLER_TAG:-$(node -p \"require('./package.json').krawler.version\")} -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k-weatherlink:observations-${IMAGE_TAG:-dev} -f dockerfile.observations ../..",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/krawler-weatherlink@0.0.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/krawler-weatherlink@0.0.0",
    "lint": "standard --fix"
  },
  "krawler": {
    "version": "2.8.2"
  },
  "dependencies": {
    "lodash": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/krawler": "workspace:*"
  }
}
