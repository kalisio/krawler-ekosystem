ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-kollectivite/package.json ./packages/krawler-kollectivite/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-kollectivite --prod

COPY packages/krawler-kollectivite/osm-jobfile.js \
     packages/krawler-kollectivite/osm-tasks.js \
     packages/krawler-kollectivite/osm-tasks-others.js \
     ./packages/krawler-kollectivite/

FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 0 0 * * *"

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-kollectivite /app/packages/krawler-kollectivite

USER root
RUN rm -rf /app/packages/krawler-kollectivite/node_modules/@kalisio/krawler \
 && ln -s /opt/krawler /app/packages/krawler-kollectivite/node_modules/@kalisio/krawler
USER node

WORKDIR /app/packages/krawler-kollectivite

CMD krawler --cron "$CRON" --run osm-jobfile.js
