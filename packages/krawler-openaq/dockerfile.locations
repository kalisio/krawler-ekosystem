ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-openaq/package.json ./packages/krawler-openaq/
COPY packages/krawler-openaq/jobfile.locations.js ./packages/krawler-openaq/

RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-openaq --prod


FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 0 0 * * *"

COPY --from=builder --chown=node:node /app /app/

RUN rm -rf /app/packages/krawler-openaq/node_modules/@kalisio/krawler \
 && ln -s /krawler/packages/krawler /app/packages/krawler-openaq/node_modules/@kalisio/krawler

WORKDIR /app/packages/krawler-openaq

CMD ["sh", "-c", "krawler --cron \"$CRON\" --run jobfile.locations.js"]
