ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-openaq/package.json ./packages/krawler-openaq/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-openaq --prod

COPY packages/krawler-openaq/jobfile.measurements.js \
     ./packages/krawler-openaq/

FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 */3 * * *"

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-openaq /app/packages/krawler-openaq

USER root
RUN rm -rf /app/packages/krawler-openaq/node_modules/@kalisio/krawler \
 && ln -s /opt/krawler /app/packages/krawler-openaq/node_modules/@kalisio/krawler
USER node

WORKDIR /app/packages/krawler-openaq

CMD krawler --cron "$CRON" --run jobfile.measurements.js
