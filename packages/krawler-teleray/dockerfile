ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-teleray/package.json ./packages/krawler-teleray/
COPY packages/krawler-teleray/jobfile.js ./packages/krawler-teleray/

RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-teleray --prod


FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 */10 * * * *"

COPY --from=builder --chown=node:node /app /app/

RUN rm -rf /app/packages/krawler-teleray/node_modules/@kalisio/krawler \
 && ln -s /krawler/packages/krawler /app/packages/krawler-teleray/node_modules/@kalisio/krawler

WORKDIR /app/packages/krawler-teleray

CMD ["sh", "-c", "krawler --cron \"$CRON\" --run jobfile.js"]
