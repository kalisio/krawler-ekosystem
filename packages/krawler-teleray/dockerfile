ARG KRAWLER_TAG=latest
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.1.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/krawler-teleray/package.json ./packages/krawler-teleray/

RUN pnpm install --frozen-lockfile --ignore-scripts --filter @kalisio/krawler-teleray --prod

COPY packages/krawler-teleray/jobfile.js \
     ./packages/krawler-teleray/

FROM kalisio/krawler:${KRAWLER_TAG}
LABEL maintainer="Kalisio <contact@kalisio.xyz>"

ENV CRON="0 */10 * * * *"

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/krawler-teleray /app/packages/krawler-teleray

RUN rm -rf /app/packages/krawler-teleray/node_modules/@kalisio/krawler \
 && ln -s /app/packages/krawler /app/packages/krawler-teleray/node_modules/@kalisio/krawler

WORKDIR /app/packages/krawler-teleray

CMD krawler --cron "$CRON" --run jobfile.js
